    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "uicockpit": "^0.7.0",
    "zod": "^3.23.8"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "design-system",
    "design-system-generator",
    "design-tokens",
    "framework-neutral",
    "ui-components",
    "tailwind",
    "shadcn",
    "wcag",
    "conformance",
    "ai",
    "agent",
    "claude",
    "cursor",
    "windsurf",
    "cline",
    "uicockpit"
  ],
  "homepage": "https://uicockpit.com",
