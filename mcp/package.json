{
  "name": "uicockpit-mcp",
  "mcpName": "com.uicockpit/mcp",
  "version": "0.6.0",
  "description": "MCP server for UIcockpit, the design system generator for AI-built apps: an agent generates a kit from a brief, reads its tokens + component grammar, and verifies its own code stays on-system (the check). Framework-neutral, free, no Figma or account.",
